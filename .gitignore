# NOTE: no blanket `.vscode/` rule. The checked-in workspace config is the
# IDE-integrated governance discovery record's teeth — a blanket ignore
# silently prevents it from ever being committed. Ignore the directory's
# contents and re-admit the two files that are meant to be tracked.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

.DS_Store
Thumbs.db
*.swp
.idea/

# Python / uv
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Schema build artifacts. JSON Schema is emitted by the CLI, never committed.
schema/build/

# KiCad fabrication outputs are generated by CI and attached to tags as
# release artifacts, never committed. Backups and autosaves are noise.
hardware/**/fab/
*-backups/
*.kicad_prl
*.kicad_sch-bak
*.kicad_pcb-bak
fp-info-cache

# ESPHome build tree
firmware/.esphome/

# Scratch clones for cross-repository work — apothecary parts are developed
# against this project's board dimensions and land upstream as pull requests,
# never here. Nothing under sandbox/ is part of this repository.
sandbox/
